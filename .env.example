# ── Required (app crashes at boot without these) ────────────────────────
# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# Optional: set to "1" to skip env validation (CI smoke builds)
# SKIP_ENV_CHECK="1"

# ── AI Providers ─────────────────────────────────────────────────────────
# The 9-step waterfall tries providers in this order until one succeeds:
#   active provider → Premium OpenAI (gpt-4o) → Premium Gemini → Groq →
#   Cerebras → DeepSeek → Gemini Flash → OpenRouter → OpenAI direct.
#
# ⚠️ PRODUCTION PARITY: all of the keys below are ALREADY configured on the
# Vercel production deployment (elimu-nova-ai). To run locally with working
# AI generation, copy each value from the Vercel dashboard:
#   https://vercel.com/<team>/elimu-nova-ai/settings/environment-variables
# Note: `vercel env pull` redacts these sensitive values (returns ""), so
# they MUST be copied manually from the dashboard into this file.
#
# At least one is required — more = better fallback coverage.
OPENAI_API_KEY=""               # set YOUR key (copy from Vercel env)
GEMINI_API_KEY=""               # set YOUR key (copy from Vercel env)
GROQ_API_KEY=""                 # set YOUR key (copy from Vercel env)
CEREBRAS_API_KEY=""             # set YOUR key (copy from Vercel env)
DEEPSEEK_API_KEY=""             # set YOUR key (copy from Vercel env)
OPENROUTER_API_KEY=""           # set YOUR key (copy from Vercel env)
OPENAI_DALLE_API_KEY=""         # set YOUR key (copy from Vercel env)
STABILITY_API_KEY=""            # set YOUR key (copy from Vercel env)
PREMIUM_OPENAI_MODEL="gpt-4o"       # LIVE in production
PREMIUM_GEMINI_MODEL="gemini-3.6-flash" # LIVE in production

# Supabase Storage (generated content files: images, PDFs, PPTX, videos)
# Use either the legacy anon key OR the newer publishable key for the browser.
NEXT_PUBLIC_SUPABASE_URL="https://project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""   # set YOUR publishable key
SUPABASE_SERVICE_ROLE_KEY=""              # set YOUR service-role key (server-side only)

# Cloudinary (optional - AI image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe (optional - billing)
STRIPE_SECRET_KEY=""                 # set YOUR secret key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # set YOUR publishable key
STRIPE_WEBHOOK_SECRET=""              # set YOUR webhook secret

# M-Pesa Daraja API (optional - mobile money payments)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MPESA_ENVIRONMENT="sandbox"

# PayPal REST API (optional - PayPal payments)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"

# Zoom Meeting SDK (optional - in-app video conferencing)
ZOOM_SDK_KEY=""
ZOOM_SDK_SECRET=""

# Zoom Server-to-Server OAuth (required for auto-creating/managing meetings)
# 1. Go to https://marketplace.zoom.us/
# 2. Create a "Server-to-Server OAuth" app
# 3. Copy Account ID, Client ID, and Client Secret
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Zoom Webhook Secret (for recording notifications)
# In your Zoom app → Feature → Event Subscriptions → Add "Recording completed" event
ZOOM_WEBHOOK_SECRET=""

# Vercel Blob (optional - file storage)
BLOB_READ_WRITE_TOKEN=""

# Email (SMTP – for sending credential emails to parents/students)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@yourdomain.com"

# Performance
NEXT_DISABLE_TURBOPACK=1

# Redis (optional — falls back to in-memory cache)
REDIS_URL=""

# Resend (alternative email provider)
RESEND_API_KEY=""

# Stock Image APIs
UNSPLASH_ACCESS_KEY=""

# WhatsApp Integration
WHATSAPP_PROVIDER=""  # twilio, africastalking
WHATSAPP_AUTH_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_FROM=""

# AI Model Overrides (optional — defaults shown)
# CEREBRAS_MODEL="gemma-4-31b"
# DEEPSEEK_MODEL="deepseek-chat"
# GEMINI_MODEL="gemini-3.6-flash"
# GROQ_MODEL="qwen/qwen3.8-27b"
# OPENAI_MODEL="gpt-4o-mini"
# PREMIUM_OPENAI_MODEL="gpt-4o"
# PREMIUM_GEMINI_MODEL="gemini-3.6-flash"
# OPENROUTER_MODEL="openai/gpt-4o-mini"

